# ===========================================================================
# Multilingual file for the TOS 7 Docker application "dockgedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Dockge"
auth         = "louislam"
version      = "@@VERSION@@"
descript     = "Dockge is a self-hosted web manager for Docker Compose stacks. It creates, edits, starts, stops, restarts and deletes compose stacks, pulls updated images, shows live logs, opens an interactive container terminal and converts docker run commands into a compose file. Compose files stay ordinary files in a stacks folder, so they survive restarts and updates. This app runs the official Docker Hub image on your NAS and opens from its desktop icon."
release_note = "1.5.0-3: Rectified review findings C2/C4/C8/C9/F5/S7/T1 - verified MIT licence and image digests, complete privacy and third-party disclosure, accurate descriptions in 23 languages, documented docker.sock exemption and sensitive-path audit (no /etc, /root or /boot mounts). Upstream 1.5.0 remains the latest release. The pinned image is unchanged and the CVE follow-up is documented."
important    = "Requires DockerEngine (auto-installed if missing). This Docker control panel mounts /var/run/docker.sock - a declared exception. The socket can control every container on this NAS, so protect the Dockge login and install only if you trust the app. It runs as non-root (1000:1000), adds no capability, uses no privileged mode or host network, and mounts only the socket file. Compose files are ordinary files in /Volume1/DockerAppData/dockgedocker/stacks (not visible in the TOS file manager)."

[zh-cn]
name         = "Dockge"
auth         = "louislam"
version      = "@@VERSION@@"
descript     = "Dockge 是自托管的 Docker Compose 栈网页管理器：可创建、编辑、启动、停止、重启和删除 compose 栈，拉取更新镜像，查看实时日志，打开容器交互终端，并能把 docker run 命令转换为 compose 文件。compose 文件以普通文件保存在 stacks 目录，重启与更新都不会丢失；本应用在 NAS 上运行官方 Docker Hub 镜像，从桌面图标打开。"
release_note = "1.5.0-3: Rectified review findings C2/C4/C8/C9/F5/S7/T1 - verified MIT licence and image digests, complete privacy and third-party disclosure, accurate descriptions in 23 languages, documented docker.sock exemption and sensitive-path audit (no /etc, /root or /boot mounts). Upstream 1.5.0 remains the latest release. The pinned image is unchanged and the CVE follow-up is documented."
important    = "依赖 DockerEngine（应用中心会在缺失时自动安装）。本应用是 Docker 控制面板，需挂载 /var/run/docker.sock，这是已申报的例外；该 socket 可控制本机全部容器，请务必保护好 Dockge 登录密码，仅在信任本应用时安装。容器仍以非 root（1000:1000）运行，不新增 capability，不用 privileged 或 host 网络，只挂载该 socket 文件。compose 文件存放在 /Volume1/DockerAppData/dockgedocker/stacks（TOS 文件管理器看不到），请用 SSH/SFTP 或 Dockge 编辑器，栈内卷写宿主绝对路径 /Volume1/...。卸载并删除数据前备份 app_data/ 与 stacks/。"

[zh-hk]
name         = "Dockge"
auth         = "louislam"
version      = "@@VERSION@@"
descript     = "Dockge 係自架嘅 Docker Compose 堆疊網頁管理器：可以建立、編輯、啟動、停止、重新啟動同刪除 compose 堆疊，拉取更新映像，睇即時日誌，打開容器互動終端，亦可以將 docker run 指令轉做 compose 檔案。compose 檔案以普通檔案保存喺 stacks 目錄，重新啟動同更新都唔會唔見；本應用喺 NAS 上跑官方 Docker Hub 映像，由桌面圖示打開。"
release_note = "1.5.0-3: Rectified review findings C2/C4/C8/C9/F5/S7/T1 - verified MIT licence and image digests, complete privacy and third-party disclosure, accurate descriptions in 23 languages, documented docker.sock exemption and sensitive-path audit (no /etc, /root or /boot mounts). Upstream 1.5.0 remains the latest release. The pinned image is unchanged and the CVE follow-up is documented."
important    = "需要 DockerEngine（應用中心會喺缺少時自動安裝）。本應用係 Docker 控制面板，要掛載 /var/run/docker.sock，呢個係已申報嘅例外；個 socket 可以控制本機全部容器，請務必保護好 Dockge 登入密碼，只喺信任本應用時安裝。容器仍然以非 root（1000:1000）執行，唔加 capability，唔用 privileged 或者 host 網絡，只掛載呢個 socket 檔案。compose 檔案放喺 /Volume1/DockerAppData/dockgedocker/stacks（TOS 檔案管理員睇唔到），請用 SSH/SFTP 或者 Dockge 編輯器，堆疊內嘅 volume 寫宿主絕對路徑 /Volume1/...。解除安裝並刪除資料前備份 app_data/ 同 stacks/。"

